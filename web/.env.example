VITE_API_BASE_URL=http://localhost:8090

# Solana RPC. По умолчанию используй backend proxy, чтобы браузер не ловил 403
# от публичных RPC. При необходимости можно заменить на Helius / QuickNode / Triton.
VITE_SOLANA_RPC=https://idenity-backend.duckdns.org/api/solana-rpc

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
